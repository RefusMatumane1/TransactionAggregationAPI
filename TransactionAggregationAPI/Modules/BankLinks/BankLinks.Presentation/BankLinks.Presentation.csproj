<Project Sdk="Microsoft.NET.Sdk">
	<!--
	The module's HTTP surface: endpoints plus the request/response contracts that cross the
	wire. Depends inward on Application only — never on Infrastructure — and Application
	DTOs are always mapped to a response type here rather than serialized directly.
	-->
	<PropertyGroup>
		<RootNamespace>Modules.BankLinks.Presentation</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MediatR" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BankLinks.Application\BankLinks.Application.csproj" />
		<ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
	</ItemGroup>
</Project>
