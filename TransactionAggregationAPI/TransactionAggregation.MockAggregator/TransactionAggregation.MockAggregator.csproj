<Project Sdk="Microsoft.NET.Sdk.Web">
	<!--
		Development-only stand-in for the external account aggregator: the OAuth consent side
		BankLinks talks to, and the push side that delivers bank transactions. It plays an
		outside system, so it references no application module — it only speaks the wire
		contracts (the aggregator's OAuth endpoints, the webhook body, the Kafka record).
		Never deployed: k8s has no manifest for it.
	-->
	<PropertyGroup>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Confluent.Kafka" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TransactionAggregationAPI.ServiceDefaults\TransactionAggregationAPI.ServiceDefaults.csproj" />
	</ItemGroup>

</Project>
