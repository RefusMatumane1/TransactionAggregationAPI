<Project Sdk="Microsoft.NET.Sdk.Web">
	<!--
		Web SDK rather than Worker SDK: the host serves no business endpoints, but it still needs
		Kestrel for /alive, /health (Kubernetes probes) and /metrics (Prometheus scrape).
	-->
	<PropertyGroup>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Serilog.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TransactionAggregationAPI.ServiceDefaults\TransactionAggregationAPI.ServiceDefaults.csproj" />
		<ProjectReference Include="..\TransactionAggregation.Hosting\TransactionAggregation.Hosting.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\.dockerignore">
			<Link>.dockerignore</Link>
		</Content>
	</ItemGroup>
</Project>
