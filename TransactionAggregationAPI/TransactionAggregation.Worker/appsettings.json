{
  "ConnectionStrings": {
    "transactiondb": "",
    "redis": "",
    "kafka": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 5,
    "ClaimTimeoutMinutes": 10
  },
  "Inbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 5,
    "ClaimTimeoutMinutes": 10
  },
  "PendingExpiry": {
    "Enabled": true,
    "ExpireAfterDays": 7,
    "CheckIntervalMinutes": 60,
    "BatchSize": 200
  },
  "Kafka": {
    "Enabled": true,
    "BankTransactionsTopic": "bank-transactions",
    "DeadLetterTopic": "bank-transactions.dlq",
    "GroupId": "transaction-aggregation-api",
    "SourceName": "kafka-bank-aggregator",
    "RequireSourceHeader": false,
    "CreateTopics": true,
    "TopicPartitions": 3,
    "TopicReplicationFactor": 1,
    "MaxRetryBackoffSeconds": 60
  },
  "NotificationOptions": {
    "DuplicateAlertWebhookUrl": ""
  }
}
