{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NotificationOptions": {
    "FraudTeamEmail": "fraud@yourcompany.com",
    "FraudWebhookUrl": "https://your-webhook.com/fraud-alerts",
    "EnablePushNotifications": true,
    "SmsEnabled": "true"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Keycloak": {
    "Authority": "http://localhost:8081",
    "PublicIssuer": "http://localhost:8081/realms/transaction-aggregation",
    "Realm": "transaction-aggregation",
    "Audience": "transaction-ui",
    "AdminClientId": "transaction-admin",
    "AdminClientSecret": "dev-only-admin-client-secret"
  }
}
