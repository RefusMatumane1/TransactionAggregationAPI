{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NotificationOptions": {
    "FraudTeamEmail": "fraud@yourcompany.com",
    "FraudWebhookUrl": "https://your-webhook.com/fraud-alerts",
    "EnablePushNotifications": true,
    "SmsEnabled": "true"
  },
  "TransactionValidationOptions": {
     "MaxTransactionAmount": 50000,
     "MaxTransactionAgeMonths": 36,
     "DailySpendingLimit": 10000
   },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "TransactionAggregationAPI",
    "Audience": "TransactionAggregationAPIClients",
    "ExpirationInMinutes": 60
  }
}
