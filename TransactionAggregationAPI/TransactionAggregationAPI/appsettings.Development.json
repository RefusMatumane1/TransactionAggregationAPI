{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Keycloak": {
    "Authority": "http://localhost:8081",
    "PublicIssuer": "http://localhost:8081/realms/transaction-aggregation",
    "Realm": "transaction-aggregation",
    "Audience": "transaction-ui",
    "AdminClientId": "transaction-admin",
    "AdminClientSecret": "dev-only-admin-client-secret"
  },
  "BankAggregator": {
    "ClientId": "transaction-aggregation-dev",
    "ClientSecret": "dev-only-mock-aggregator-client-secret",
    "AuthorizeEndpoint": "http://localhost:5090/oauth/authorize",
    "TokenEndpoint": "http://localhost:5090/oauth/token",
    "AccountEndpoint": "http://localhost:5090/accounts/me",
    "RedirectUri": "https://localhost:5101/bank-links/callback"
  },
  "MockAggregator": {
    "WebhookApiKey": "dev-only-mock-aggregator-webhook-key-not-a-secret",
    "SourceName": "mock-aggregator"
  }
}
