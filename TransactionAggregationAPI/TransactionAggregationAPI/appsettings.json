{
  "ConnectionStrings": {
    "transactiondb": "",
    "redis": ""
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5101", "http://localhost:8081" ]
  },
  "BankAggregator": {
    "ClientId": "",
    "ClientSecret": "",
    "AuthorizeEndpoint": "",
    "TokenEndpoint": "",
    "AccountEndpoint": "",
    "RedirectUri": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Keycloak": {
    "Authority": "",
    "PublicIssuer": "",
    "Realm": "",
    "Audience": "",
    "AdminClientId": "",
    "AdminClientSecret": ""
  },
  "NotificationOptions": {
    "DuplicateAlertWebhookUrl": ""
  }
}