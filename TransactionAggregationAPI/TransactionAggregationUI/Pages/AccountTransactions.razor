@page "/accounts/{AccountId:guid}/transactions"
@attribute [Authorize]
@inject AuthService AuthService
@inject TransactionService TransactionService
@inject IJSRuntime JS

<PageTitle>Transactions</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Transactions</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="SyncTransactions" disabled="@_syncing">
            @if (_syncing) { <span class="spinner-border spinner-border-sm me-1"></span> }
            <i class="bi bi-arrow-repeat me-1"></i>Sync
        </button>
        <button class="btn btn-sm btn-outline-success" @onclick="ExportCsv">
            <i class="bi bi-download me-1"></i>Export CSV
        </button>
    </div>
</div>

@if (_syncMessage is not null)
{
    <div class="alert alert-@(_syncSuccess ? "success" : "danger") py-2 mb-3 alert-dismissible">
        @_syncMessage
        <button type="button" class="btn-close" @onclick="() => _syncMessage = null"></button>
    </div>
}

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-2">
                <label class="form-label small">From</label>
                <input type="date" class="form-control form-control-sm"
                       @bind="_filters.FromDate" @bind:format="yyyy-MM-dd" />
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small">To</label>
                <input type="date" class="form-control form-control-sm"
                       @bind="_filters.ToDate" @bind:format="yyyy-MM-dd" />
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small">Category</label>
                <select class="form-select form-select-sm" @bind="_categoryFilter">
                    <option value="">All</option>
                    @foreach (var c in Enum.GetValues<TransactionCategory>())
                    {
                        <option value="@((int)c)">@c</option>
                    }
                </select>
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small">Status</label>
                <select class="form-select form-select-sm" @bind="_statusFilter">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues<TransactionStatus>())
                    {
                        <option value="@((int)s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small">Search</label>
                <input class="form-control form-control-sm" @bind="_filters.SearchTerm" placeholder="Description…" />
            </div>
            <div class="col-sm-4 col-md-2">
                <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilters">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else if (_transactions.Count == 0)
{
    <div class="alert alert-info">No transactions match the current filters.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Source</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in _transactions)
                    {
                        <tr>
                            <td>@tx.TransactionDate.ToString("dd MMM yyyy")</td>
                            <td>@tx.Description</td>
                            <td class="@(tx.Amount >= 0 ? "text-success" : "text-danger")">
                                @tx.Amount.ToString("C", new System.Globalization.CultureInfo("en-ZA"))
                            </td>
                            <td><CategoryBadge Category="@tx.Category" /></td>
                            <td><StatusBadge Status="@tx.Status" /></td>
                            <td class="text-muted small">@tx.SourceSystem</td>
                            <td>
                                <select class="form-select form-select-sm"
                                        style="min-width:130px"
                                        @onchange="e => RecategorizeAsync(tx.Id, e)">
                                    @foreach (var cat in Enum.GetValues<TransactionCategory>())
                                    {
                                        <option value="@((int)cat)" selected="@(tx.Category == cat)">@cat</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (_totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(_currentPage - 1)">«</button>
                </li>
                @for (int p = 1; p <= _totalPages; p++)
                {
                    var page = p;
                    <li class="page-item @(_currentPage == page ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(page)">@(page)</button>
                    </li>
                }
                <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(_currentPage + 1)">»</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    [Parameter] public Guid AccountId { get; set; }

    private List<TransactionModel> _transactions = [];
    private TransactionFilterParams _filters = new();
    private bool _loading = true;
    private bool _syncing;
    private string? _syncMessage;
    private bool _syncSuccess;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private string _categoryFilter = "";
    private string _statusFilter = "";
    private Guid _customerId;

    protected override async Task OnInitializedAsync()
    {
        var userIdStr = AuthService.GetCurrentUserId();
        if (Guid.TryParse(userIdStr, out _customerId))
            await LoadTransactions();
        _loading = false;
    }

    private async Task LoadTransactions()
    {
        _loading = true;
        _filters.PageNumber = _currentPage;

        if (int.TryParse(_categoryFilter, out var catInt))
            _filters.Category = (TransactionCategory)catInt;
        else
            _filters.Category = null;

        if (int.TryParse(_statusFilter, out var stInt))
            _filters.Status = (TransactionStatus)stInt;
        else
            _filters.Status = null;

        var result = await TransactionService.FilterTransactionsAsync(_customerId, _filters);
        _transactions = result?.Items?.ToList() ?? [];
        _totalPages = result?.TotalPages ?? 1;
        _loading = false;
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadTransactions();
    }

    private async Task GoToPage(int page)
    {
        _currentPage = page;
        await LoadTransactions();
    }

    private async Task SyncTransactions()
    {
        _syncing = true;
        _syncMessage = null;
        var (success, error) = await TransactionService.SyncTransactionsAsync(_customerId);
        _syncing = false;
        _syncSuccess = success;
        _syncMessage = success ? "Transactions synced successfully." : error;
        if (success) await LoadTransactions();
    }

    private async Task RecategorizeAsync(Guid txId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            await TransactionService.CategorizeTransactionAsync(txId, (TransactionCategory)val);
        await LoadTransactions();
    }

    private async Task ExportCsv()
    {
        var (success, data, error) = await TransactionService.ExportCsvAsync(
            _customerId, _filters.FromDate, _filters.ToDate, _filters.Category);

        if (success && data is not null)
        {
            var base64 = Convert.ToBase64String(data);
            await JS.InvokeVoidAsync("eval",
                $"const a=document.createElement('a');a.href='data:text/csv;base64,{base64}';" +
                $"a.download='transactions.csv';a.click();");
        }
    }
}
