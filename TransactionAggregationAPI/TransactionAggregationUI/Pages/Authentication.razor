@page "/authentication/{action}"
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<RemoteAuthenticatorView Action="@Action">
    <LogOutSucceeded>
        <div class="text-center mt-5">
            <i class="bi bi-box-arrow-right fs-1 text-secondary"></i>
            <h5 class="mt-3">You're signed out</h5>
            <p class="text-muted">You've been signed out of this app and of your account.</p>
            <a href="/" class="btn btn-primary">Sign in again</a>
        </div>
    </LogOutSucceeded>
    <LogOutFailed Context="message">
        <div class="text-center mt-5">
            <h5>Couldn't sign you out</h5>
            <p class="text-muted">@message</p>
            <a href="/" class="btn btn-outline-secondary">Back to the app</a>
        </div>
    </LogOutFailed>
</RemoteAuthenticatorView>

@code {
    [Parameter] public string? Action { get; set; }
}
