@page "/bank-links"
@attribute [Authorize]
@inject BankLinkService BankLinkService
@inject NavigationManager Nav

<PageTitle>Linked banks</PageTitle>

<div class="mb-4">
    <h4 class="mb-1">Linked banks</h4>
    <p class="text-muted small mb-0">
        Link a bank account to bring its transactions in automatically. You'll be sent to your
        bank to approve access, then back here.
    </p>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger py-2">@_error</div>
}

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var institution in Enum.GetValues<Institution>())
        {
            var link = _links.FirstOrDefault(l => l.Institution == institution);
            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-0"><i class="bi bi-bank me-1"></i>@institution.DisplayName()</h6>
                            @StatusBadge(link)
                        </div>

                        @switch (link?.Status)
                        {
                            case BankLinkStatus.Active:
                                <p class="text-muted small">Linked @link.LinkedAt.ToLocalTime().ToString("d MMM yyyy")</p>
                                @if (link.AccountId is { } accountId)
                                {
                                    <a href="/accounts/@accountId/transactions" class="btn btn-sm btn-outline-primary mt-auto">
                                        <i class="bi bi-list-ul me-1"></i>Transactions
                                    </a>
                                }
                                break;

                            case BankLinkStatus.PendingAuthorization:
                                <p class="text-muted small">Linking wasn't finished.</p>
                                @LinkButton(institution, "Try again")
                                break;

                            case BankLinkStatus.NeedsReauthorization:
                                <p class="text-muted small">Your bank needs you to approve access again.</p>
                                @LinkButton(institution, "Reconnect")
                                break;

                            default:
                                <p class="text-muted small">Not linked.</p>
                                @LinkButton(institution, "Link")
                                break;
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<BankLinkModel> _links = [];
    private bool _loading = true;
    private Institution? _starting;
    private string? _error;
    private Guid _customerId;

    protected override async Task OnInitializedAsync()
    {
        var userId = AuthState is null ? null : (await AuthState).User.GetUserId();
        if (userId is { } id)
        {
            _customerId = id;
            _links = await BankLinkService.GetLinksAsync(_customerId);
        }
        _loading = false;
    }

    private async Task StartLinkAsync(Institution institution)
    {
        _starting = institution;
        _error = null;

        var (authorizationUrl, error) = await BankLinkService.InitiateAsync(_customerId, institution);
        if (authorizationUrl is null)
        {
            _error = error ?? "Couldn't start linking. Please try again.";
            _starting = null;
            return;
        }

        // Leaves the app for the bank's consent page; it returns to /bank-links/callback.
        Nav.NavigateTo(authorizationUrl, forceLoad: true);
    }

    private RenderFragment LinkButton(Institution institution, string label) => __builder =>
    {
        <button class="btn btn-sm btn-primary mt-auto" disabled="@(_starting is not null)"
                @onclick="() => StartLinkAsync(institution)">
            @if (_starting == institution)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            @label
        </button>
    };

    private static RenderFragment StatusBadge(BankLinkModel? link) => __builder =>
    {
        var (css, text) = link?.Status switch
        {
            BankLinkStatus.Active => ("bg-success", "Linked"),
            BankLinkStatus.PendingAuthorization => ("bg-warning text-dark", "Unfinished"),
            BankLinkStatus.NeedsReauthorization => ("bg-warning text-dark", "Reconnect"),
            _ => ("bg-secondary", "Not linked")
        };
        <span class="badge @css">@text</span>
    };
}
