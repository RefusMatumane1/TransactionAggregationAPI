@page "/"
@attribute [Authorize]
@inject AuthService AuthService
@inject CustomerService CustomerService
@inject TransactionService TransactionService
@inject AccountService AccountService

<PageTitle>Dashboard</PageTitle>

<h4 class="mb-4">Dashboard</h4>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else if (_customer is not null)
{
    <div class="mb-2 text-muted">Welcome back, <strong>@_customer.Name</strong></div>

    <!-- Summary stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <StatCard Label="Total Income" Value="@($"{_summary?.TotalIncome.ToString("C", new System.Globalization.CultureInfo("en-ZA"))}")"
                      IconClass="bi-arrow-down-circle-fill" IconBg="bg-success" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Label="Total Expenses" Value="@($"{_summary?.TotalExpenses.ToString("C", new System.Globalization.CultureInfo("en-ZA"))}")"
                      IconClass="bi-arrow-up-circle-fill" IconBg="bg-danger" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Label="Net Balance" Value="@($"{_summary?.NetBalance.ToString("C", new System.Globalization.CultureInfo("en-ZA"))}")"
                      IconClass="bi-wallet2" IconBg="bg-primary" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Label="Transactions" Value="@($"{_summary?.TotalTransactions}")"
                      IconClass="bi-receipt" IconBg="bg-info" />
        </div>
    </div>

    <div class="row g-3">
        <!-- Spending by category -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Spending by Category</div>
                <div class="card-body p-0">
                    @if (_summary?.SpendingByCategory is { Count: > 0 })
                    {
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Category</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (cat, amt) in _summary.SpendingByCategory.OrderByDescending(x => x.Value))
                                {
                                    <tr>
                                        <td>
                                            <span class="badge badge-@cat">@cat</span>
                                        </td>
                                        <td class="text-end">@amt.ToString("C", new System.Globalization.CultureInfo("en-ZA"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted p-3">No spending data.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Account list -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
                    <span>Accounts</span>
                    <a href="/accounts" class="btn btn-sm btn-outline-primary">Manage</a>
                </div>
                <div class="card-body p-0">
                    @if (_accounts.Count > 0)
                    {
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th class="text-end">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var acc in _accounts)
                                {
                                    <tr>
                                        <td>
                                            <a href="/accounts/@acc.Id/transactions">@acc.AccountName</a>
                                        </td>
                                        <td><span class="badge bg-secondary">@acc.AccountType</span></td>
                                        <td class="text-end">@acc.Balance.ToString("C",  new System.Globalization.CultureInfo("en-ZA"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted p-3">No accounts yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Could not load profile. Please try again.</div>
}

@code {
    private CustomerModel? _customer;
    private TransactionSummaryModel? _summary;
    private List<AccountModel> _accounts = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var userIdStr = AuthService.GetCurrentUserId();
        if (Guid.TryParse(userIdStr, out var userId))
        {
                var customerTask = CustomerService.GetCustomerAsync(userId);
            var summaryTask = TransactionService.GetSummaryAsync(userId);
            var accountsTask = AccountService.GetAccountsAsync(userId);
            await Task.WhenAll(customerTask, summaryTask, accountsTask);
            _customer = customerTask.Result;
            _summary = summaryTask.Result;
            _accounts = accountsTask.Result;
        }
        _loading = false;
    }
}
