@page "/summary"
@attribute [Authorize]
@inject AuthService AuthService
@inject TransactionService TransactionService

<PageTitle>Transaction Summary</PageTitle>

<h4 class="mb-4">Transaction Summary</h4>

<!-- Date range picker -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label class="form-label small">From</label>
                <input type="date" class="form-control" @bind="_startDate" @bind:format="yyyy-MM-dd" />
            </div>
            <div class="col-sm-4 col-md-3">
                <label class="form-label small">To</label>
                <input type="date" class="form-control" @bind="_endDate" @bind:format="yyyy-MM-dd" />
            </div>
            <div class="col-sm-4 col-md-2">
                <button class="btn btn-primary w-100" @onclick="LoadSummary">
                    <i class="bi bi-search me-1"></i>Apply
                </button>
            </div>
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else if (_summary is not null)
{
    <!-- Stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <StatCard Label="Total Income" Value="@_summary.TotalIncome.ToString("C",  new System.Globalization.CultureInfo("en-ZA"))"
                      IconClass="bi-arrow-down-circle-fill" IconBg="bg-success" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Label="Total Expenses" Value="@_summary.TotalExpenses.ToString("C",  new System.Globalization.CultureInfo("en-ZA"))"
                      IconClass="bi-arrow-up-circle-fill" IconBg="bg-danger" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Label="Net Balance" Value="@_summary.NetBalance.ToString("C",  new System.Globalization.CultureInfo("en-ZA"))"
                      IconClass="bi-wallet2" IconBg="bg-primary" />
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Label="Period" Value="@($"{_summary.Period.Days} days")"
                      IconClass="bi-calendar-range" IconBg="bg-secondary" />
        </div>
    </div>

    <div class="row g-3">
        <!-- Category breakdown -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Spending by Category</div>
                <div class="card-body p-0">
                    @if (_summary.SpendingByCategory.Count > 0)
                    {
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Category</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var total = _summary.SpendingByCategory.Values.Sum();
                                }
                                @foreach (var (cat, amt) in _summary.SpendingByCategory.OrderByDescending(x => x.Value))
                                {
                                    var pct = total > 0 ? amt / total * 100 : 0;
                                    <tr>
                                        <td><span class="badge badge-@cat">@cat</span></td>
                                        <td class="text-end">@amt.ToString("C", new System.Globalization.CultureInfo("en-ZA"))</td>
                                        <td class="text-end text-muted">@pct.ToString("F1")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted p-3">No category data available.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Monthly spending -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Monthly Spending</div>
                <div class="card-body p-0">
                    @if (_summary.SpendingByMonth.Count > 0)
                    {
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Month</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (month, amt) in _summary.SpendingByMonth.OrderBy(x => x.Key))
                                {
                                    <tr>
                                        <td>@month</td>
                                        <td class="text-end">@amt.ToString("C",  new System.Globalization.CultureInfo("en-ZA"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted p-3">No monthly data available.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction status summary -->
    <div class="row g-3 mt-1">
        <div class="col-sm-4">
            <StatCard Label="Total Transactions" Value="@_summary.TotalTransactions.ToString()"
                      IconClass="bi-receipt" IconBg="bg-info" />
        </div>
        <div class="col-sm-4">
            <StatCard Label="Completed" Value="@_summary.CompletedTransactions.ToString()"
                      IconClass="bi-check-circle-fill" IconBg="bg-success" />
        </div>
        <div class="col-sm-4">
            <StatCard Label="Pending" Value="@_summary.PendingTransactions.ToString()"
                      IconClass="bi-clock-fill" IconBg="bg-warning" />
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Could not load summary data.</div>
}

@code {
    private TransactionSummaryModel? _summary;
    private bool _loading = true;
    private DateTime _startDate = DateTime.Today.AddMonths(-12);
    private DateTime _endDate = DateTime.Today;
    private Guid _customerId;

    protected override async Task OnInitializedAsync()
    {
        var userIdStr = AuthService.GetCurrentUserId();
        Guid.TryParse(userIdStr, out _customerId);
        await LoadSummary();
    }

    private async Task LoadSummary()
    {
        _loading = true;
        _summary = await TransactionService.GetSummaryAsync(_customerId, _startDate, _endDate);
        _loading = false;
    }
}
