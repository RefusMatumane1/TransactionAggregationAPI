@* The router moves focus to the h1 on navigation (FocusOnNavigate), so keyboard and screen-reader users land on the new page. *@
<div class="page-header">
    <div>
        <h1 class="page-title" tabindex="-1">@Title</h1>
        @if (Subtitle is not null)
        {
            <div class="page-subtitle">@Subtitle</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="d-flex flex-wrap align-items-center gap-2">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
