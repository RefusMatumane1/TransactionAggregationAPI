@* The direction is announced by the header's aria-sort; the icon is for sighted users only. *@
<i class="bi @(Active ? (Descending ? "bi-arrow-down" : "bi-arrow-up") : "bi-arrow-down-up opacity-25")" aria-hidden="true"></i>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Descending { get; set; } = true;
}
