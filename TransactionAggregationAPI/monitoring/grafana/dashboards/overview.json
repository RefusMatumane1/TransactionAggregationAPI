        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"transaction-api\"}[5m])))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
