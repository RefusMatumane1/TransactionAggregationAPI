    {
      "type": "table",
      "title": "Firing alerts",
      "description": "Alert rules: monitoring/prometheus-rules.yml (k8s: k8s/monitoring/prometheus/configmap.yaml). No Alertmanager — nothing is paged.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 5
