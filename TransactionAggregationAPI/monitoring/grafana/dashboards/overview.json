          "expr": "sum by (class) (label_replace(rate(http_request_duration_seconds_count{job=\"transaction-api\"}[5m]), \"class\", \"${1}xx\", \"code\", \"([0-9])..\"))",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ]
    },
