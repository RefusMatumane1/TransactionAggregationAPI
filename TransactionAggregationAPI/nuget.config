<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins restore to nuget.org only, for every developer and CI alike. Without this, whatever
  sources a machine has configured (private feeds, local folders) take part in restore, which
  is both non-reproducible and a dependency-confusion risk — NuGet warns NU1507 about exactly
  that under central package management.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
